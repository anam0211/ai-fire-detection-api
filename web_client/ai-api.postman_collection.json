    {
      "name": "IR + 75 C (send 3 samples over >=2 seconds)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/sensor-data",
        "description": "First sample MEDIUM; HIGH after >=3 consecutive IR samples spanning >=2 seconds. Do not burst requests.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"{{device_id}}_fusion\",\n  \"temperature\": 75,\n  \"infrared\": 1\n}",
